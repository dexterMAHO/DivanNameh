# Local development (.env is loaded only in the development profile).
# Generate a local secret with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_ENV=development
SECRET_KEY=replace-with-a-generated-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
APP_TIME_ZONE=Asia/Tehran
# Optional locally; unset/empty uses BASE_DIR/db.sqlite3.
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=

# Production: set these in Render Environment, NOT in a committed .env.
# DJANGO_ENV=production
# DJANGO_SETTINGS_MODULE=config.settings_production
# SECRET_KEY=<generated-random-value-at-least-50-characters>
# DEBUG=False
# DATABASE_URL=postgresql://ROLE:ENCODED_PASSWORD@DIRECT_NEON_HOST/DATABASE?sslmode=require
# DATABASE_MIGRATION_URL=<direct-url-if-DATABASE_URL-is-pooled>
# ALLOWED_HOSTS=your-custom-domain.example
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.example
# RENDER_EXTERNAL_HOSTNAME is supplied by Render; automatically trusted.
# TRUST_PROXY=True
# DB_CONN_MAX_AGE=0
# WEB_CONCURRENCY=2
# PORT is supplied by Render; local Gunicorn defaults to 8000.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
