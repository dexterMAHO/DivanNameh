DIVAN_DOMAIN={{ divan_domain }}
DIVAN_ORIGIN=https://{{ divan_domain }}
DIVAN_WORKERS={{ divan_workers | default(2) | int }}
DIVAN_IMAGE_TAG={{ divan_revision.stdout }}
DIVAN_BIND_ADDRESS=0.0.0.0
DIVAN_HTTP_BIND_ADDRESS={{ '127.0.0.1' if divan_use_existing_nginx | bool else '0.0.0.0' }}
DIVAN_HTTP_PORT={{ divan_nginx_http_port if divan_use_existing_nginx | bool else 80 }}
DIVAN_HTTPS_PORT=443
