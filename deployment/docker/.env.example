# Copy to .env.docker in the repo root, then generate both values with openssl.
DIVAN_SECRET_KEY=
DIVAN_DB_PASSWORD=
DIVAN_DOMAIN=localhost
DIVAN_ORIGIN=https://localhost:8443
DIVAN_BIND_ADDRESS=127.0.0.1
DIVAN_HTTP_PORT=8080
DIVAN_HTTPS_PORT=8443

# --- Demo site (compose.demo.yaml). Leave unset if you do not run the demo. ---
# Its own secret key and database password: the demo must not be able to sign
# cookies for the live site, and must not share its database.
DIVAN_DEMO_SECRET_KEY=
DIVAN_DEMO_DB_PASSWORD=
DIVAN_DEMO_DOMAIN=demo.localhost
DIVAN_DEMO_ORIGIN=https://demo.localhost:8443
DIVAN_DEMO_WORKERS=1
